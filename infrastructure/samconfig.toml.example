version = 0.1

[default.deploy.parameters]
stack_name = "portfolio-aws"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
region = "us-east-1"
confirm_changeset = true
# PrimaryDomainName and CertificateArn default to the project's production domain.
# Optionally set NotificationEmail and confirm its SNS subscription after deploy.
# parameter_overrides = "NotificationEmail=\"you@example.com\""
